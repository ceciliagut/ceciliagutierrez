<script>
  // Theme toggle for this page
  function updateDsIcons() {
    const isDark = document.documentElement.classList.contains("dark");
    document.querySelectorAll(".ds-icon-sun").forEach((el) => el.classList.toggle("hidden", !isDark));
    document.querySelectorAll(".ds-icon-moon").forEach((el) => el.classList.toggle("hidden", isDark));
  }
  updateDsIcons();
  document.getElementById("ds-theme-toggle")?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    updateDsIcons();
    // Also update the main site's icons if present
    document.querySelectorAll(".theme-icon-sun").forEach((el) => el.classList.toggle("hidden", !isDark));
    document.querySelectorAll(".theme-icon-moon").forEach((el) => el.classList.toggle("hidden", isDark));
  });

  // Animation demos
  function replay(targetId: string, props: { opacity?: string; transform?: string }) {
    const el = document.querySelector(`#${targetId} > *`) as HTMLElement;
    if (!el) return;
    el.style.opacity = props.opacity ?? "0";
    el.style.transform = props.transform ?? "none";
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        el.style.opacity = "1";
        el.style.transform = "translateY(0) scaleX(1)";
      });
    });
  }

  // Special handling for scale-x (it's not a child, it IS the element)
  function replayScaleX() {
    const el = document.getElementById("demo-scale-x") as HTMLElement;
    if (!el) return;
    el.style.transform = "scaleX(0)";
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        el.style.transform = "scaleX(1)";
      });
    });
  }

  document.getElementById("btn-fade-up")?.addEventListener("click", () => {
    replay("demo-fade-up", { opacity: "0", transform: "translateY(30px)" });
  });
  document.getElementById("btn-fade-in")?.addEventListener("click", () => {
    replay("demo-fade-in", { opacity: "0" });
  });
  document.getElementById("btn-scale-x")?.addEventListener("click", replayScaleX);

  // Auto-play on load
  setTimeout(() => replay("demo-fade-up", { opacity: "0", transform: "translateY(30px)" }), 300);
  setTimeout(() => replay("demo-fade-in", { opacity: "0" }), 500);
  setTimeout(replayScaleX, 700);
</script>

