---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Divider from "@/components/ui/Divider.astro";
import ArrowUpRight from "@/components/icons/ArrowUpRight.astro";
---

<BaseLayout title="Design System — Cecilia Gutierrez" description="Design tokens, typography, and component reference." locale="en">

<div class="max-w-5xl mx-auto px-8 md:px-16 py-16 md:py-24">

  <!-- Header -->
  <header class="mb-24">
    <span class="font-body text-[11px] tracking-[0.4em] uppercase text-muted-foreground mb-6 block">Reference</span>
    <h1 class="font-display text-5xl md:text-7xl font-medium leading-[0.95]">
      Design <span class="italic">System</span>
    </h1>
    <p class="font-body text-base md:text-lg leading-[1.8] text-muted-foreground mt-8 max-w-2xl">
      Living reference of every design token, typographic scale, and component pattern used across this site.
      Built with Tailwind CSS custom properties — what you see here is the real system, not a mockup.
    </p>
    <nav class="mt-10 flex flex-wrap gap-6 font-body text-[11px] tracking-[0.2em] uppercase text-muted-foreground">
      <a href="#colors" class="hover:text-foreground transition-colors duration-300">Colors</a>
      <a href="#typography" class="hover:text-foreground transition-colors duration-300">Typography</a>
      <a href="#components" class="hover:text-foreground transition-colors duration-300">Components</a>
      <a href="#animations" class="hover:text-foreground transition-colors duration-300">Animations</a>
      <a href="#spacing" class="hover:text-foreground transition-colors duration-300">Spacing</a>
      <a href="#icons" class="hover:text-foreground transition-colors duration-300">Icons</a>
    </nav>
  </header>

  <!-- ================================================ -->
  <!-- COLORS -->
  <!-- ================================================ -->
  <section id="colors" class="mb-32">
    <span class="font-body text-[11px] tracking-[0.4em] uppercase text-muted-foreground mb-6 block">01</span>
    <h2 class="font-display text-4xl md:text-6xl font-medium mb-16">
      Color <span class="italic">Palette</span>
    </h2>

    <p class="font-body text-sm text-muted-foreground mb-12 max-w-2xl leading-[1.8]">
      All colors are HSL values stored as CSS custom properties and consumed through Tailwind's semantic classes.
      The palette adapts between light and dark mode — primary (crimson) and accent (teal) remain constant.
    </p>

    <!-- Core Semantic Colors -->
    <h3 class="font-display text-xl font-medium mb-8">Core Palette</h3>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-16">
      <div>
        <div class="aspect-square rounded-sm bg-background border border-border"></div>
        <p class="font-mono text-[10px] mt-3 text-muted-foreground">background</p>
        <p class="font-mono text-[10px] text-muted-foreground/60">white / warm dark brown</p>
      </div>
      <div>
        <div class="aspect-square rounded-sm bg-foreground"></div>
        <p class="font-mono text-[10px] mt-3 text-muted-foreground">foreground</p>
        <p class="font-mono text-[10px] text-muted-foreground/60">warm brown / white</p>
      </div>
      <div>
        <div class="aspect-square rounded-sm bg-primary"></div>
        <p class="font-mono text-[10px] mt-3 text-muted-foreground">primary</p>
        <p class="font-mono text-[10px] text-muted-foreground/60">crimson — constant across modes</p>
      </div>
    </div>

    <!-- Surface & Muted Colors -->
    <h3 class="font-display text-xl font-medium mb-8">Surfaces</h3>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-16">
      <div>
        <div class="aspect-square rounded-sm bg-muted"></div>
        <p class="font-mono text-[10px] mt-3 text-muted-foreground">muted</p>
        <p class="font-mono text-[10px] text-muted-foreground/60">subtle backgrounds, shimmer</p>
      </div>
      <div>
        <div class="aspect-square rounded-sm border-2 border-border flex items-center justify-center"></div>
        <p class="font-mono text-[10px] mt-3 text-muted-foreground">border</p>
        <p class="font-mono text-[10px] text-muted-foreground/60">dividers, card edges</p>
      </div>
      <div>
        <div class="aspect-square rounded-sm bg-primary flex items-center justify-center">
          <span class="font-body text-sm text-primary-foreground">Aa</span>
        </div>
        <p class="font-mono text-[10px] mt-3 text-muted-foreground">primary-foreground</p>
        <p class="font-mono text-[10px] text-muted-foreground/60">text on primary</p>
      </div>
    </div>

    <!-- Text Colors -->
    <h3 class="font-display text-xl font-medium mb-8">Text</h3>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div>
        <div class="aspect-[3/2] rounded-sm bg-background border border-border flex items-center justify-center">
          <span class="font-body text-sm text-foreground">foreground</span>
        </div>
        <p class="font-mono text-[10px] mt-3 text-muted-foreground/60">headings, primary text</p>
      </div>
      <div>
        <div class="aspect-[3/2] rounded-sm bg-background border border-border flex items-center justify-center">
          <span class="font-body text-sm text-muted-foreground">muted-foreground</span>
        </div>
        <p class="font-mono text-[10px] mt-3 text-muted-foreground/60">body text, labels, metadata</p>
      </div>
      <div>
        <div class="aspect-[3/2] rounded-sm bg-background border border-border flex items-center justify-center">
          <span class="font-body text-sm text-primary">primary</span>
        </div>
        <p class="font-mono text-[10px] mt-3 text-muted-foreground/60">link hover state</p>
      </div>
      <div>
        <div class="aspect-[3/2] rounded-sm bg-background border border-border flex items-center justify-center">
          <span class="font-body text-sm text-card-foreground">card-foreground</span>
        </div>
        <p class="font-mono text-[10px] mt-3 text-muted-foreground/60">gallery heading, 404</p>
      </div>
    </div>
  </section>

  <Divider />

  <!-- ================================================ -->
  <!-- TYPOGRAPHY -->
  <!-- ================================================ -->
  <section id="typography" class="mb-32 mt-24">
    <span class="font-body text-[11px] tracking-[0.4em] uppercase text-muted-foreground mb-6 block">02</span>
    <h2 class="font-display text-4xl md:text-6xl font-medium mb-16">
      Type <span class="italic">Scale</span>
    </h2>

    <!-- Font Families -->
    <h3 class="font-display text-xl font-medium mb-8">Font Families</h3>
    <div class="space-y-10 mb-20">
      <div class="border border-border p-8 md:p-10">
        <p class="font-mono text-[10px] tracking-[0.2em] uppercase text-muted-foreground mb-4">font-display — Cormorant Garamond</p>
        <p class="font-display text-4xl md:text-5xl font-medium">The quick brown fox jumps over the lazy dog</p>
        <p class="font-display text-4xl md:text-5xl italic mt-2">The quick brown fox jumps over the lazy dog</p>
      </div>
      <div class="border border-border p-8 md:p-10">
        <p class="font-mono text-[10px] tracking-[0.2em] uppercase text-muted-foreground mb-4">font-body — DM Sans</p>
        <p class="font-body text-lg">The quick brown fox jumps over the lazy dog</p>
        <p class="font-body text-lg font-medium mt-2">The quick brown fox jumps over the lazy dog (medium)</p>
        <p class="font-body text-lg font-light mt-2">The quick brown fox jumps over the lazy dog (light)</p>
      </div>
      <div class="border border-border p-8 md:p-10">
        <p class="font-mono text-[10px] tracking-[0.2em] uppercase text-muted-foreground mb-4">font-mono — JetBrains Mono</p>
        <p class="font-mono text-base">const design = system.tokens();</p>
        <p class="font-mono text-base font-bold mt-2">const design = system.tokens(); (bold)</p>
      </div>
    </div>

    <!-- Type Scale -->
    <h3 class="font-display text-xl font-medium mb-8">Scale in Use</h3>
    <div class="space-y-8 mb-20">
      <div class="border-b border-border pb-6">
        <p class="font-mono text-[10px] text-muted-foreground mb-3">Hero title — display / text-6xl to text-9xl / medium / tracking-tight</p>
        <h1 class="font-display text-6xl md:text-8xl lg:text-9xl font-medium leading-[0.9] tracking-tight">
          Cecilia <span class="italic">Gutierrez</span>
        </h1>
      </div>
      <div class="border-b border-border pb-6">
        <p class="font-mono text-[10px] text-muted-foreground mb-3">Section heading — display / text-4xl to text-6xl / medium</p>
        <h2 class="font-display text-4xl md:text-6xl font-medium">
          Selected <span class="italic">Work</span>
        </h2>
      </div>
      <div class="border-b border-border pb-6">
        <p class="font-mono text-[10px] text-muted-foreground mb-3">Artwork title — display / text-3xl to text-5xl / normal</p>
        <h1 class="font-display text-3xl md:text-5xl text-foreground leading-tight">
          Peligros de Fumar
        </h1>
      </div>
      <div class="border-b border-border pb-6">
        <p class="font-mono text-[10px] text-muted-foreground mb-3">Card title — display / text-2xl to text-3xl / medium</p>
        <h3 class="font-display text-2xl md:text-3xl font-medium">Substack</h3>
      </div>
      <div class="border-b border-border pb-6">
        <p class="font-mono text-[10px] text-muted-foreground mb-3">Section label — body / text-[11px] / tracking-[0.4em] uppercase</p>
        <span class="font-body text-[11px] tracking-[0.4em] uppercase text-muted-foreground">About Me</span>
      </div>
      <div class="border-b border-border pb-6">
        <p class="font-mono text-[10px] text-muted-foreground mb-3">Body text — body / text-base to text-lg / leading-[1.8]</p>
        <p class="font-body text-base md:text-lg leading-[1.8] text-muted-foreground max-w-2xl">
          I'm a senior fullstack engineer building fintech products during the day and painting canvases during the night. I believe software and art share the same core discipline: care in craft.
        </p>
      </div>
      <div class="border-b border-border pb-6">
        <p class="font-mono text-[10px] text-muted-foreground mb-3">Metadata — body / text-[10px] to text-[11px] / tracking-[0.3em] uppercase</p>
        <p class="font-body text-[11px] tracking-[0.3em] uppercase text-muted-foreground">Oil on canvas — 2025 — 60 x 80 cm</p>
      </div>
      <div>
        <p class="font-mono text-[10px] text-muted-foreground mb-3">Nav item — body / text-[11px] / tracking-[0.25em] uppercase</p>
        <span class="font-body text-[11px] tracking-[0.25em] uppercase text-muted-foreground hover:text-foreground transition-colors duration-300 cursor-pointer">Gallery</span>
      </div>
    </div>
  </section>

  <Divider />

  <!-- ================================================ -->
  <!-- COMPONENTS -->
  <!-- ================================================ -->
  <section id="components" class="mb-32 mt-24">
    <span class="font-body text-[11px] tracking-[0.4em] uppercase text-muted-foreground mb-6 block">03</span>
    <h2 class="font-display text-4xl md:text-6xl font-medium mb-16">
      Component <span class="italic">Library</span>
    </h2>

    <!-- Section Header Pattern -->
    <div class="mb-20">
      <h3 class="font-display text-xl font-medium mb-2">Section Header</h3>
      <p class="font-body text-sm text-muted-foreground mb-8">Label + heading with italic accent. Used at the top of every content section.</p>
      <div class="border border-border p-10 md:p-12 text-center">
        <span class="font-body text-[11px] tracking-[0.4em] uppercase text-muted-foreground mb-6 block">Label Text</span>
        <h2 class="font-display text-4xl md:text-6xl font-medium">
          Regular <span class="italic">Accent</span>
        </h2>
      </div>
    </div>

    <!-- Inline Link -->
    <div class="mb-20">
      <h3 class="font-display text-xl font-medium mb-2">Inline Link</h3>
      <p class="font-body text-sm text-muted-foreground mb-8">Used within body text. Underlined, transitions to primary on hover.</p>
      <div class="border border-border p-10 md:p-12">
        <p class="font-body text-base md:text-lg leading-[1.8] text-muted-foreground">
          I currently work at{" "}
          <a href="#" class="text-foreground font-medium underline underline-offset-4 hover:text-primary transition-colors duration-300">N26</a>
          {" "}as a senior fullstack engineer in the{" "}
          <a href="#" class="text-foreground font-medium underline underline-offset-4 hover:text-primary transition-colors duration-300">subscriptions</a>
          {" "}sector.
        </p>
      </div>
    </div>

    <!-- Bordered Card -->
    <div class="mb-20">
      <h3 class="font-display text-xl font-medium mb-2">Bordered Card</h3>
      <p class="font-body text-sm text-muted-foreground mb-8">Used for writing platform links. Border darkens on hover.</p>
      <div class="grid md:grid-cols-2 gap-8">
        <a href="#" class="group block p-10 md:p-12 border border-border hover:border-foreground/20 transition-all duration-500 relative">
          <div class="flex items-start justify-between mb-8">
            <h3 class="font-display text-2xl md:text-3xl font-medium text-foreground">Substack</h3>
            <ArrowUpRight size={18} class="text-muted-foreground group-hover:text-foreground group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300 mt-2" />
          </div>
          <p class="font-body text-sm leading-[1.8] text-muted-foreground">
            Personal essays, reflections on craft, and the intersection of engineering and art.
          </p>
        </a>
        <a href="#" class="group block p-10 md:p-12 border border-border hover:border-foreground/20 transition-all duration-500 relative">
          <div class="flex items-start justify-between mb-8">
            <h3 class="font-display text-2xl md:text-3xl font-medium text-foreground">Medium</h3>
            <ArrowUpRight size={18} class="text-muted-foreground group-hover:text-foreground group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300 mt-2" />
          </div>
          <p class="font-body text-sm leading-[1.8] text-muted-foreground">
            Technical writing about frontend engineering, tooling, and developer experience.
          </p>
        </a>
      </div>
    </div>

    <!-- CTA Button -->
    <div class="mb-20">
      <h3 class="font-display text-xl font-medium mb-2">CTA Button</h3>
      <p class="font-body text-sm text-muted-foreground mb-8">Bordered button with arrow icon. Used for primary actions like booking a call.</p>
      <div class="border border-border p-10 md:p-12 flex justify-center">
        <a href="#" class="group inline-flex items-center gap-3 px-10 py-5 border border-border hover:border-foreground/20 transition-all duration-500">
          <span class="font-display text-xl md:text-2xl font-medium text-foreground">Book a Session</span>
          <ArrowUpRight size={18} class="text-muted-foreground group-hover:text-foreground group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300" />
        </a>
      </div>
    </div>

    <!-- Category Filters -->
    <div class="mb-20">
      <h3 class="font-display text-xl font-medium mb-2">Category Filters</h3>
      <p class="font-body text-sm text-muted-foreground mb-8">Tab-style filter bar. Active tab has visible bottom border.</p>
      <div class="border border-border p-10 md:p-12">
        <div class="flex justify-center gap-8 font-body text-[11px] tracking-[0.2em] uppercase">
          <button class="text-foreground border-b border-foreground pb-2 transition-colors duration-300">All</button>
          <button class="text-muted-foreground border-b border-transparent pb-2 hover:text-foreground transition-colors duration-300">Oil</button>
          <button class="text-muted-foreground border-b border-transparent pb-2 hover:text-foreground transition-colors duration-300">Charcoal</button>
          <button class="text-muted-foreground border-b border-transparent pb-2 hover:text-foreground transition-colors duration-300">Pastel</button>
          <button class="text-muted-foreground border-b border-transparent pb-2 hover:text-foreground transition-colors duration-300">Digital</button>
        </div>
      </div>
    </div>

    <!-- Back Link -->
    <div class="mb-20">
      <h3 class="font-display text-xl font-medium mb-2">Back Link</h3>
      <p class="font-body text-sm text-muted-foreground mb-8">Navigation back link with arrow. Used on detail pages.</p>
      <div class="border border-border p-10 md:p-12">
        <a href="#" class="inline-flex items-center gap-2 font-body text-[11px] tracking-[0.3em] uppercase text-muted-foreground hover:text-foreground transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
          Back to gallery
        </a>
      </div>
    </div>

    <!-- Divider -->
    <div class="mb-20">
      <h3 class="font-display text-xl font-medium mb-2">Divider</h3>
      <p class="font-body text-sm text-muted-foreground mb-8">Centered horizontal rule. Max width xs, animated with scale-x on scroll.</p>
      <div class="border border-border p-10 md:p-16">
        <div class="h-px bg-border max-w-xs mx-auto"></div>
      </div>
    </div>

    <!-- Shimmer Skeleton -->
    <div class="mb-20">
      <h3 class="font-display text-xl font-medium mb-2">Shimmer Skeleton</h3>
      <p class="font-body text-sm text-muted-foreground mb-8">Loading placeholder for lazy-loaded images. Animated gradient.</p>
      <div class="border border-border p-10 md:p-12">
        <div class="grid grid-cols-3 gap-3">
          <div class="aspect-[3/4] shimmer rounded-sm"></div>
          <div class="aspect-[3/4] shimmer rounded-sm"></div>
          <div class="aspect-[3/4] shimmer rounded-sm"></div>
        </div>
      </div>
    </div>

    <!-- Contact Link -->
    <div class="mb-20">
      <h3 class="font-display text-xl font-medium mb-2">Contact Link Row</h3>
      <p class="font-body text-sm text-muted-foreground mb-8">Used in the Connect section. Label above, display text below, arrow on right.</p>
      <div class="border border-border p-10 md:p-12 bg-foreground">
        <div class="max-w-lg mx-auto">
          <a href="#" class="group flex items-center justify-between py-8 border-b border-white/20 hover:border-white/50 transition-colors duration-300">
            <div>
              <span class="font-body text-[10px] tracking-[0.4em] uppercase text-white/50 block mb-2">Email</span>
              <span class="font-body text-base md:text-lg text-white">ceciliainesgutierrez@gmail.com</span>
            </div>
            <ArrowUpRight size={16} class="text-white/50 group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300" />
          </a>
          <a href="#" class="group flex items-center justify-between py-8 border-b border-white/20 hover:border-white/50 transition-colors duration-300">
            <div>
              <span class="font-body text-[10px] tracking-[0.4em] uppercase text-white/50 block mb-2">LinkedIn</span>
              <span class="font-body text-base md:text-lg text-white">linkedin.com/in/gutierrez-cecilia</span>
            </div>
            <ArrowUpRight size={16} class="text-white/50 group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300" />
          </a>
        </div>
      </div>
    </div>

    <!-- Theme Toggle -->
    <div>
      <h3 class="font-display text-xl font-medium mb-2">Theme Toggle</h3>
      <p class="font-body text-sm text-muted-foreground mb-8">Sun/moon icon button. Toggles .dark class on html element. Try it — the entire page will switch.</p>
      <div class="border border-border p-10 md:p-12 flex items-center justify-center gap-6">
        <button
          id="ds-theme-toggle"
          class="text-muted-foreground hover:text-foreground transition-colors duration-300 border border-border px-6 py-3 inline-flex items-center gap-3"
        >
          <svg class="ds-icon-sun hidden w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path><path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path><path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path>
          </svg>
          <svg class="ds-icon-moon w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
          <span class="font-body text-[11px] tracking-[0.2em] uppercase">Toggle Theme</span>
        </button>
      </div>
    </div>
  </section>

  <Divider />

  <!-- ================================================ -->
  <!-- ANIMATIONS -->
  <!-- ================================================ -->
  <section id="animations" class="mb-32 mt-24">
    <span class="font-body text-[11px] tracking-[0.4em] uppercase text-muted-foreground mb-6 block">04</span>
    <h2 class="font-display text-4xl md:text-6xl font-medium mb-16">
      Motion <span class="italic">& Transitions</span>
    </h2>

    <div class="space-y-16">
      <!-- Fade Up -->
      <div>
        <h3 class="font-display text-xl font-medium mb-2">Fade Up</h3>
        <p class="font-body text-sm text-muted-foreground mb-6">Default entrance animation. Opacity 0 + translateY(30px) to visible. 0.8s ease-out.</p>
        <div class="border border-border p-10 md:p-12">
          <div id="demo-fade-up" class="text-center">
            <p class="font-display text-2xl font-medium opacity-0 translate-y-[30px]" style="transition: opacity 0.8s ease-out, transform 0.8s ease-out">Fade Up Element</p>
          </div>
          <div class="text-center mt-6">
            <button id="btn-fade-up" class="font-body text-[10px] tracking-[0.2em] uppercase text-muted-foreground border border-border px-4 py-2 hover:text-foreground transition-colors">
              Replay
            </button>
          </div>
        </div>
      </div>

      <!-- Fade In -->
      <div>
        <h3 class="font-display text-xl font-medium mb-2">Fade In</h3>
        <p class="font-body text-sm text-muted-foreground mb-6">Opacity only, no translate. 0.6s ease-out. Used for nav elements.</p>
        <div class="border border-border p-10 md:p-12">
          <div id="demo-fade-in" class="text-center">
            <p class="font-display text-2xl font-medium opacity-0" style="transition: opacity 0.6s ease-out">Fade In Element</p>
          </div>
          <div class="text-center mt-6">
            <button id="btn-fade-in" class="font-body text-[10px] tracking-[0.2em] uppercase text-muted-foreground border border-border px-4 py-2 hover:text-foreground transition-colors">
              Replay
            </button>
          </div>
        </div>
      </div>

      <!-- Scale X -->
      <div>
        <h3 class="font-display text-xl font-medium mb-2">Scale X</h3>
        <p class="font-body text-sm text-muted-foreground mb-6">Horizontal scale from center. Used for dividers. 1s ease-out.</p>
        <div class="border border-border p-10 md:p-16">
